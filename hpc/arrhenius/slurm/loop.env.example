# Plan 069 item 5: one run's settings on Arrhenius. Copy next to the run (project storage, e.g.
# $P/runs/loop20x11.env), fill in the first block, and submit with
#   hpc/arrhenius/slurm/submit.sh --env $P/runs/loop20x11.env [--dry-run] loop --chain 6
# The job scripts source it on the host; every container process sources a snapshot of it (kept
# as RUN_DIR/slurm/env/job-<id>.loop.env), so a knob changed here takes effect at the next job.
# Plain `export` lines only; paths must be inside APPTAINER_BIND (project storage) or the image.

# ---- the allocation and the job shape (hpc/arrhenius/slurm/) ----------------------------------
export PROJECT=naiss2026-NN-gpu                         # the GPU account (-A naiss<N>-gpu; CPU is a separate one)
export P=/nobackup/proj/disk/naiss2026-NN/botbowl       # Lustre: images, runs, models, corpora
export SIF=$P/images/botbowl-COMMIT.sif                 # hpc/arrhenius/build_image.sh's output
export BIN_MODE=image             # image: the image's binaries and scripts; checkout: $CHECKOUT, built by the job
# export CHECKOUT=$P/botbowl_rust CHECKOUT_TARGET=$P/target/20x11   # BIN_MODE=checkout (README)
export RUN_NAME=loop20x11
export RUN_DIR=$P/runs/$RUN_NAME MODEL_DIR=$P/models/$RUN_NAME
export PARTITION=gpu NODES=4 GPUS_PER_NODE=4 CORES_PER_GPU=72
export WALLTIME=2:00:00           # the centre's default; raise to its maximum once known (README)
export SIGNAL_SECS=600            # USR1 this long before the end: the clean-shutdown backstop
export STOP_MARGIN_MIN=20         # the floor; each phase also gets 1.25x what it took last time
# export SBATCH_EXTRA="-C <feature> --qos=..."  # `sinfo -o %f` lists the features
# export GPU_ARGS="--gpus-per-node=4"           # default --gpus=<NODES*4>, as the centre's example
export WORKERS_PER_GPU=1 WORKER_STREAMS=64      # long-lived workers: tuned by plan 069 item 4's suite
export WORKER_MEM_FLOOR_MB=4096
export PIN=slurm                  # srun's binding (-c 72 per task); numactl adds --cpunodebind/--preferred
export GPU_NUMA="0 1 2 3"         # PIN=numactl only: NUMA node of local task i (topology.txt)
# export LOCAL_SCRATCH=/scratch/local          # node-local NVMe; default $SNIC_TMP, else $TMPDIR, else /tmp
export HUB_PORT=7777
# Persistent-hub variant (README): the hub runs on a PCD virtual machine and the loop never starts one.
# export HUB_EXTERNAL=1 HUB_HOST=<pcd-vm> HUB_PORT=7777
# Where the trainer's prepared data goes: unset = the generation dir (Lustre disk tier, as on the
# box); `local` = node 0's NVMe (rebuilt by the next job when a deadline falls between prepare and
# train); or a path on the Lustre flash tier, if the project has quota there.
# export PREPARED_ROOT=local

# ---- the loop (scripts/train_loop.sh), as scripts/launch_plan065.sh sets it on the training box ----
export INIT_CHAMPION=$P/models/init/bbnet_mix16x9v9_gen49.onnx   # + .pt and .ts beside it (copied over)
export TIER_OVERRIDE=mix16x9v9
export SIZE_MODE=centred BUILD_W=20 BUILD_H=11 BUILD_PLAYERS=7 NN_CANVAS=13x22
export BOARD_SIZE_W=20 BOARD_SIZE_H=11 BOARD_PLAYERS=7
export SIZE_CENTRE=220 SIZE_TEMPERATURE=0.3 SIZE_FLOOR=0.2 SIZE_MAX_AREA=220 SIZE_MIN_AREA=70
export SIZE_ASPECT=1.5-2.8 SIZE_CELLS_PER_PLAYER=26
export ANCHOR=$P/models/init/anchor_mix16x9_gen13_v9.onnx ANCHOR_EVERY=0 P1_GAMES=0
export EVAL_BOARD_SIZES=16x9,20x11 EVAL_RUNGS= EVAL_GAMES=30
# cfgs/ resolve inside the image (BIN_MODE=image) or the checkout.
export GEN_BOT_CONFIG=/opt/botbowl/src/cfgs/chance_all_partial_gen.toml
export EVAL_BOT_CONFIG=/opt/botbowl/src/cfgs/chance_all_partial.toml NET_CHECK_CONFIG=/opt/botbowl/src/cfgs/chance_all_partial.toml
export MCTS_ITERS=1000 EVAL_MCTS_ITERS=1000 EXPLORE_ARGS=""
export EVAL_VENUE=drives DRIVE_REF=$P/models/init/bbnet_mix16x9d1k_gen04_v9.onnx DRIVE_SPRT=0.5:0.55 DRIVE_CAP=800
export DRIVE_POSITIONS=$P/positions/contested_16x9_gen04g.json,$P/positions/contested_20x11_gen48.json
export ORIGIN_EVERY=0
export CQ_TAU=100 WARM_LR=5e-5 SELECT_ON=combined EVAL_EVERY=1000 ABSORB_PROBE=on
export TRAIN_EXTRA_ARGS="--freeze-bn --eval-at 250,500"
export VALUE_BLEND=1.0 MC_LABEL_PLAYOUTS=8 NEXT_DRIVE=1 DRIVE_EVAL_EVERY=3
export VALUE_WEIGHT=0.36 MAX_GENS=60
export VALUE_BENCH=$P/value_bench/v9_gen01_val.jsonl VALUE_BENCH_2=$P/value_bench/v9_20x11_val.jsonl
export NET_CHECK=on NET_CHECK_BOARDS=16x9,20x11
# Labels always go through the hub here: the long-lived workers are where the GPUs are.
export LABEL_VIA_HUB=1
# Plan 069 item 4b: label inside the generate phase instead (the same mc/ shards, done with the last
# game). Each worker then runs WORKER_STREAMS game + WORKER_LABEL_STREAMS label streams (the loop's
# own worker GEN_PARALLEL_GAMES + LABEL_STREAMS); size them with hpc/tune's `mix` rows, mode = "worker".
# export LABEL_STREAMING=1 LABEL_STREAMS=128 WORKER_LABEL_STREAMS=128
# Games per shard scale with the fleet: 8 shards x GAMES_PER_SHARD per generation. The box ran 150
# on one GTX 1060; a 4-node job has 16 H100s.
export GAMES_PER_SHARD=600
# The loop's own per-phase worker on task 0's GPU (generate / label streams); the long-lived workers use
# WORKER_STREAMS above.
export GEN_PARALLEL_GAMES=64 LABEL_PARALLEL_GAMES=64 MC_LABEL_PARALLEL=64 EVAL_PARALLEL_GAMES=32
export WORKER_MEM_FLOOR_MB=4096
export NN_BACKEND=inproc
export TRAIN_DEVICE=cuda
export HUB_ALLOW_FROM=""
# loop.sbatch skips the heuristic mirror match (writes .mirror.done) unless SKIP_MIRROR=0.
